# Exactly 32 cryptographically random bytes encoded as base64.
ECRYPT_MASTER_KEY=

# Separate 32-byte base64 secret for signed, document-bound wallet challenges.
ECRYPT_CHALLENGE_SECRET=

# Identifies the active wrapping-key version stored in each new package.
ECRYPT_ACTIVE_KEY_ID=local-2026-08

# Optional JSON map of retained local key versions for rotation/self-hosting.
# ECRYPT_WRAPPING_KEYS={"local-2026-08":"<base64 key>"}

# Production replay protection and daily cleanup (provided by Vercel Blob/cron).
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Server-only Alchemy application key used for live token ownership checks.
ALCHEMY_API_KEY=

# Optional AWS KMS/HSM-backed production wrapping through Vercel OIDC.
# ECRYPT_KEY_WRAPPER=aws-kms
# AWS_REGION=eu-west-1
# AWS_ROLE_ARN=arn:aws:iam::<account>:role/ecrypt-vercel-kms
# AWS_KMS_KEY_ID=arn:aws:kms:<region>:<account>:key/<key-id>
